{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Docs",
            "type": "shell",
            "command": "mkdocs build --strict"
        },
        {
            "label": "Clean Docs",
            "type": "shell",
            "command": "mkdocs build --strict --clean"
        },
        {
            "label": "Serve Docs (Clean)",
            "type": "shell",
            "command": "mkdocs serve -s -c -o"
        },
        {
            "label": "Serve Docs (Dirty)",
            "type": "shell",
            "command": "mkdocs serve -s --dirty -o"
        },
        {
            "label": "build",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/src/RSML.CLI/RSML.CLI.csproj",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary;ForceNoAlign"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "publish",
            "command": "dotnet",
            "type": "process",
            "args": [
                "publish",
                "${workspaceFolder}/src/RSML.CLI/RSML.CLI.csproj",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary;ForceNoAlign"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "watch",
            "command": "dotnet",
            "type": "process",
            "args": [
                "watch",
                "run",
                "--project",
                "${workspaceFolder}/src/RSML.CLI/RSML.CLI.csproj"
            ],
            "problemMatcher": "$msCompile"
        }
    ]
}
