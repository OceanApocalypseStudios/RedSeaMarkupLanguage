<Solution>
	<Configurations>
		<Platform Name="Any CPU" />
		<Platform Name="ARM32" />
		<Platform Name="ARM64" />
		<Platform Name="x64" />
		<Platform Name="x86" />
	</Configurations>
    
	<Folder Name="/Solution Items/">
		<File Path=".gitignore" />
		<File Path="cliff.toml" />
		<File Path="mkdocs.yml" />
		<File Path="README.md" />
	</Folder>
    
    <Folder Name="/Solution Items/Assets/">
        <File Path="assets/logo.png" />
        <File Path="assets/icon.png" />
    </Folder>
    
    <Folder Name="/Solution Items/Information/">
        <File Path="BENCHMARKS.md" />
        <File Path="EDITOR.md" />
        <File Path="LANGUAGES.md" />
    </Folder>
    
    <Folder Name="/Solution Items/Licenses/">
        <File Path="LICENSE-DOCS.txt" />
        <File Path="LICENSE.txt" />
        <File Path="COPYING.txt" />
    </Folder>

	<Folder Name="/Tests and Benchmarks/">
		<Project Path="benchmarks/RSML.Benchmarks.csproj">
			<Platform Solution="*|ARM64" Project="ARM64" />
			<Platform Solution="*|x64" Project="x64" />
			<Platform Solution="*|x86" Project="x86" />
		</Project>
		<Project Path="tests/RSML.NativeTests/RSML.NativeTests.csproj">
			<Platform Solution="*|ARM64" Project="ARM64" />
			<Platform Solution="*|x64" Project="x64" />
			<Platform Solution="*|x86" Project="x86" />
		</Project>
		<Project Path="tests/RSML.Tests/RSML.Tests.csproj">
            <Platform Solution="*|ARM64" Project="ARM64" />
			<Platform Solution="*|x64" Project="x64" />
			<Platform Solution="*|x86" Project="x86" />
		</Project>
	</Folder>
	<Project Path="src/RSML.CLI/RSML.CLI.csproj">
		<Platform Solution="*|ARM64" Project="ARM64" />
		<Platform Solution="*|x64" Project="x64" />
		<Platform Solution="*|x86" Project="x86" />
	</Project>
	<Project Path="src/RSML.Native/RSML.Native.csproj">
		<Platform Solution="*|ARM64" Project="ARM64" />
		<Platform Solution="*|x64" Project="x64" />
		<Platform Solution="*|x86" Project="x86" />
	</Project>
	<Project Path="src/RSML.Sdk/RSML.Sdk.csproj">
		<Platform Solution="*|ARM64" Project="ARM64" />
		<Platform Solution="*|x64" Project="x64" />
		<Platform Solution="*|x86" Project="x86" />
	</Project>
	<Project Path="src/RSML/RSML.csproj">
		<Platform Solution="*|ARM64" Project="ARM64" />
		<Platform Solution="*|x64" Project="x64" />
		<Platform Solution="*|x86" Project="x86" />
	</Project>

</Solution>
