# null vs unknown
null # used for types like string, boolean, etc
unknown # used for types like int - has the value of the minimum allowed Int32 value

# Default (immutable) Variables - CAN BE OVERWRITTEN BY EXTENSIONS
$cli # boolean - true if running from the CLI
$version # string - language version
$host.isLinux # boolean - true if host is linux
$host.systemName # string?
$host.systemVersion # int
$host.processorArchitecture # string?
$host.distroName # string?
$host.distroFamily # string?

# Default keywords
fail
fail string? # error message overload
requires string
_end # not recommended
_end object? # not recommended. essentially return and fail() all in one
delete string # string is the name of the variable to save to
return # returns with no value and status FALSE
return object # returns with status TRUE and value
return null # returns with status FALSE and no value

# About _end()
_end # literally return / return null
_end object?  # if object is false or null, it's fail(). if not it's return

# Regex extension
isMatch string? string # second string is pattern

# Diagnostics extension
writeState
dumpState string
listExtensions

# Console extension
writeln object?
write object?
readln string?
read string?
readKey string? string # second string is name of variable to save to

# Legacy.V2 extension
->
!>
N>
any
defined
undefined
windows
osx
linux
freebsd
ubuntu
debian
archlinux
fedora
x64
x86
arm32
arm64
loongarch64
"" # false string - string with no escape abilities
