{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "metadata": [
    {
      "src": [
        {
          "src": "../src/",
          "files": [
            "**/*.csproj"
          ]
        }
      ],
      "output": "api",
      "memberLayout": "separatePages",
      "includeExplicitInterfaceImplementations": true
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "**/*.{md,yml}"
        ],
        "exclude": [
          "__site/**"
        ]
      }
    ],
    "resource": [
      {
        "files": [
          "images/**",
          "articles/images/**"
        ]
      }
    ],
    "output": "__site",
    "template": [
      "default",
      "templates/singulinkfx"
    ],
    "globalMetadata": {
      "_appName": "Red Sea Markup Language",
      "_appTitle": "Red Sea Markup Language",
      "_appFaviconPath": "images/favicon.ico",
      "_appLogoPath": "images/small.png",
      "_enableSearch": true,
      "pdf": true,
      "_enableNewTab": true,
      "_appFooter": "See on <a href=\"https://github.com/OceanApocalypseStudios/RedSeaMarkupLanguage/\">GitHub</a>.<br/>Docs made with <a href=\"https://dotnet.github.io/docfx/\">DocFX</a> and <a href=\"https://github.com/Singulink/SingulinkFX\">SingulinkFX</a>.",
      "_copyrightFooter": "OceanApocalypseStudios. Documentation licensed under CC0 1.0."
    },
    "markdownEngineProperties": {
      "markdigExtensions": [
          "SmartyPants",
          "ListExtras",
          "Footnotes",
          "Footers",
          "Figures",
          "DefinitionLists"
      ],
      "alerts": {
        "ARTICLE": "alert alert-article"
      }
    }
  }
}
