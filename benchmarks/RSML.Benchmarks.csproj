<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFrameworks>net10.0;net8.0;net481;net472</TargetFrameworks>
		<OutputType>Exe</OutputType>
		<Nullable>enable</Nullable>
		<LangVersion>latest</LangVersion>
		<Platforms>AnyCPU;ARM64;x64;x86;ARM32</Platforms>
		<RootNamespace>OceanApocalypseStudios.RSML.Benchmarks</RootNamespace>
		<DebugType>pdbonly</DebugType>
		<DebugSymbols>true</DebugSymbols>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<Optimize>true</Optimize>
		<Configuration>Release</Configuration>
		<IsPackable>false</IsPackable>
	</PropertyGroup>
	<ItemGroup>
		<PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
		<PackageReference Include="BenchmarkDotNet.Diagnostics.Windows" Version="0.15.8" Condition="'$(OS)' == 'Windows_NT'" />
	</ItemGroup>
	<ItemGroup>
		<ProjectReference Include="..\src\RSML\RSML.csproj" />
		<ProjectReference Include="..\src\RSML.Extensibility\RSML.Extensibility.csproj" />
	</ItemGroup>
</Project>